# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which LLM to use for extraction and synthesis.
# Options: claude | gemini | openai
LLM_PROVIDER=claude

# Model override — leave blank to use the provider default:
#   claude  → claude-sonnet-4-5
#   gemini  → gemini-1.5-flash
#   openai  → gpt-4o-mini
LLM_MODEL=

# ── API Keys ──────────────────────────────────────────────────────────────────
# Only the key for your chosen LLM_PROVIDER is required.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path — created automatically on first run.
# On Streamlit Cloud, use a writable path like /tmp/sector_intel.db
DATABASE_PATH=data/sector_intel.db

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Cron schedule for automatic refresh (APScheduler format, IST timezone)
# Default: every Sunday at 02:00 IST
REFRESH_CRON=0 2 * * 0
